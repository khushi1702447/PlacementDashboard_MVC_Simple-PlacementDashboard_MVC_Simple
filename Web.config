<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <add name="PlacementDB" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=PlacementDB;Integrated Security=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8">
      <assemblies>
        <add assembly="CrystalDecisions.CrystalReports.Engine" />
        <add assembly="CrystalDecisions.Shared" />
        <add assembly="CrystalDecisions.Web" />
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.8" />
  </system.web>
</configuration>
